{
  "name": "@octoworkers/worker",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "dev:remote": "wrangler dev --remote --port 8787",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:migrate:remote:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "@modelcontextprotocol/client": "^2.2.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@octoworkers/com": "workspace:*",
    "agents": "^0.28.0",
    "ai": "^6.0.149",
    "hono": "^4.13.13",
    "hono-agents": "^3.0.12",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  }
}
