{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "octoworkers",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "kv_namespaces": [
    {
      "binding": "APP_KV",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  "vars": {
    "ENV_NAME": "production",
    "APP_DOMAIN": "REPLACE_WITH_DOMAIN",
    "ADMIN_DOMAIN": "admin.REPLACE_WITH_DOMAIN",
    "SAAS_DOMAIN": "app.REPLACE_WITH_DOMAIN",
    "ADMIN_ACCESS_MODE": "session",
    "ADMIN_ALLOWED_EMAILS": "",
    "ADMIN_LOGIN_EMAIL": "REPLACE_WITH_ADMIN_EMAIL",
    "CLOUDFLARE_ACCOUNT_ID": "REPLACE_WITH_ACCOUNT_ID",
    "CLOUDFLARE_IMAGES_DELIVERY_HASH": "",
    "AI_GATEWAY_ACCOUNT_ID": "REPLACE_WITH_ACCOUNT_ID",
    "AI_GATEWAY_ID": "default",
    "AI_PROVIDER": "workers-ai",
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct",
    "AI_TEXT_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    "AI_EMBED_MODEL": "@cf/baai/bge-small-en-v1.5",
    "GITHUB_ALLOWED_USERS": "",
    "GITHUB_CLIENT_ID": "",
    "CF_ACCESS_TEAM_DOMAIN": "",
    "CF_ACCESS_AUD": "",
    "ENABLE_AI": "false",
    "ENABLE_AGENTS": "false",
    "ENABLE_VECTOR": "false",
    "ENABLE_EXAMPLES": "false",
    "ENABLE_KAKAO": "false",
    "ENABLE_GROBLE": "false",
    "KAKAO_REDIRECT_URI": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "octoworkers",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "./migrations"
    }
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  },
  "env": {
    "staging": {
      "name": "octoworkers-staging",
      "vars": {
        "ENV_NAME": "staging",
        "APP_DOMAIN": "staging.REPLACE_WITH_DOMAIN",
        "ADMIN_DOMAIN": "admin-staging.REPLACE_WITH_DOMAIN",
        "SAAS_DOMAIN": "app-staging.REPLACE_WITH_DOMAIN",
        "ADMIN_ACCESS_MODE": "session",
        "ADMIN_ALLOWED_EMAILS": "",
        "ADMIN_LOGIN_EMAIL": "REPLACE_WITH_ADMIN_EMAIL",
        "CLOUDFLARE_ACCOUNT_ID": "REPLACE_WITH_ACCOUNT_ID",
        "CLOUDFLARE_IMAGES_DELIVERY_HASH": "",
        "AI_GATEWAY_ACCOUNT_ID": "REPLACE_WITH_ACCOUNT_ID",
        "AI_GATEWAY_ID": "default",
        "AI_PROVIDER": "workers-ai",
        "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct",
        "AI_TEXT_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
        "AI_EMBED_MODEL": "@cf/baai/bge-small-en-v1.5",
        "GITHUB_ALLOWED_USERS": "",
        "GITHUB_CLIENT_ID": "",
        "CF_ACCESS_TEAM_DOMAIN": "",
        "CF_ACCESS_AUD": "",
        "ENABLE_AI": "false",
        "ENABLE_AGENTS": "false",
        "ENABLE_VECTOR": "false",
        "ENABLE_EXAMPLES": "false",
        "ENABLE_KAKAO": "false",
        "ENABLE_GROBLE": "false",
        "KAKAO_REDIRECT_URI": ""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "octoworkers-staging",
          "database_id": "REPLACE_WITH_STAGING_D1_DATABASE_ID",
          "migrations_dir": "./migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "APP_KV",
          "id": "REPLACE_WITH_STAGING_KV_NAMESPACE_ID"
        }
      ],
      "triggers": {
        "crons": [
          "17 * * * *"
        ]
      }
    }
  }
}
